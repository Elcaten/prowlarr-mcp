# Base URL of your Prowlarr instance (no trailing /api)
PROWLARR_URL=http://localhost:9696

# API key - generate in Prowlarr Settings > General (format: 32-char alphanumeric)
PROWLARR_API_KEY=

# Set to 1 to allow the live integration suite to exercise write tools
# (currently only a scratch Tag create+delete round-trip). Leave unset for read-only.
PROWLARR_ALLOW_WRITES=

# MCP-layer bearer token. Required when FASTMCP_TRANSPORT is http/sse/streamable-http;
# ignored for stdio. Clients send Authorization: Bearer <this value>.
PROWLARR_MCP_TOKEN=

# FastMCP transport. Default stdio (local). Set http to bind 127.0.0.1:8000/mcp.
# FASTMCP_TRANSPORT=stdio
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=8000

# Comma-separated portmanteau groups to register. Empty/unset = all groups.
# PROWLARR_MCP_GROUPS=prowlarr_search,prowlarr_history
